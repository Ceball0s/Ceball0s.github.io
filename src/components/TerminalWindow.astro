---
// components/TerminalWindow.astro
import type { SocialLink, UserInfo, SkillCategory } from '../types';

// Cargar datos con manejo de errores
let infoData: any = {};
let socialLinks: SocialLink[] = [];
let userInfo: UserInfo | null = null;
let skillCategories: SkillCategory[] = [];

try {
  const data = await import('../../public/data/info.json');
  infoData = data.default || data;
  
  socialLinks = infoData.socialLinks || [];
  userInfo = infoData.fullTexts || null;
  skillCategories = infoData.skillCategories || [];
} catch (error) {
  console.error('Error loading info.json:', error);
  
  // Datos de respaldo
  socialLinks = [
    {
      name: 'GitHub',
      url: 'https://github.com/Ceball0s',
      iconClass: 'fab fa-github',
      color: '#181717'
    }
  ];
  
  userInfo = {
    title: "SOBRE MÍ",
    name: "Miguel Angel Ceballos",
    role: "Desarrollador Full Stack",
    location: "Tuluá, Colombia",
    skills: []
  };
}
---
<div class="mobile-container">
<div class="terminal-window">
  <!-- Barra de título estilo Ubuntu -->
  <div class="terminal-titlebar">
    <div class="terminal-buttons">
      <span class="close-btn"></span>
      <span class="minimize-btn"></span>
      <span class="maximize-btn"></span>
    </div>
    <span class="title">terminal@portfolio:~</span>
  </div>
  
  <!-- Contenido de la terminal -->
  <div class="terminal-content">
    <div class="terminal-line">
      <span class="user">miguel@portfolio</span>:<span class="path">~</span>$ whoami
    </div>
    
    <!-- Información del usuario -->
    <div class="whoami-output">
      {userInfo ? (
        <>
          <!-- Contenedor principal con dos columnas -->
          <div class="content-main">
            <!-- Columna izquierda: Información del usuario -->
            <div class="user-info">
              <h3>👤 {userInfo.name}</h3>
              <p class="role">{userInfo.role}</p>
              <p class="location">📍 {userInfo.location}</p>
            </div>
            
            <!-- Columna derecha: Enlaces sociales -->
            {socialLinks.length > 0 && (
              <div class="social-section">
                <h4>🌐 Conecta conmigo:</h4>
                <div class="social-links">
                  {socialLinks.map((link) =>
                    link.url.startsWith("mailto:") ? (
                      <a
                        href="#"
                        class="social-link"
                        style={`--link-color: ${link.color}`}
                        onclick={`
                          navigator.clipboard.writeText('miguel.yate@correounivalle.edu.co');
                          showNotification({
                            title: 'Correo copiado',
                            message: 'miguel.yate@correounivalle.edu.co',
                            icon: 'fa-envelope',
                            color: '#EA4335'
                          });
                          return false;
                        `}
                      >
                        <i class={link.iconClass}></i>
                        {link.name}
                      </a>
                    ) : (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="social-link"
                        style={`--link-color: ${link.color}`}
                      >
                        <i class={link.iconClass}></i>
                        {link.name}
                      </a>
                    )
                  )}
                </div>
              </div>
            )}
          </div>
          
          <!-- Habilidades (debajo, ocupando todo el ancho) -->
          {skillCategories.length > 0 && (
            <div class="skills-section">
              <h4>🛠️ Habilidades:</h4>
              <div class="skill-categories">
                {skillCategories.map((category) => (
                  <div class="skill-category">
                    <strong>{category.name}:</strong>
                    <span>{category.skills.join(', ')}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="error-message">
          <p>⚠️ No se pudo cargar la información del usuario</p>
          <p class="hint">Verifica que public/data/info.json exista</p>
        </div>
      )}
    </div>
    
    <!-- Nuevo prompt -->
    <div class="terminal-line">
      <span class="user">miguel@portfolio</span>:<span class="path">~</span>$ <span class="cursor">█</span>
    </div>
  </div>
</div>
</div>
<style>
  .terminal-window {
    background: #1e1e1e;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.5);
    font-family: 'Ubuntu Mono', monospace;
    
    /* TAMAÑO MÁS PEQUEÑO Y COMPACTO */
    width: 930px; /* Más pequeño */
    height: 670px; /* Más compacto */
    
    position: absolute;
    top: 60px; /* Posición fija */
    left: 30px;
    z-index: 10;
    border: 1px solid #333;
    display: flex;
    flex-direction: column;
  }

  .terminal-titlebar {
    background: #252525;
    padding: 15px 15px;
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid #333;
    flex-shrink: 0;
  }

  .terminal-buttons {
    display: flex;
    gap: 6px;
  }

  .terminal-buttons span {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;
    cursor: pointer;
    transition: transform 0.2s;

  }

  .close-btn { background: #ff5f56; }
  .minimize-btn { background: #ffbd2e; }
  .maximize-btn { background: #27ca3f; }

  .title {
    color: #ddd;
    font-size: 0.8rem;
    margin-left: 8px;
    font-weight: 500;
  }

  /* Aumentar tamaño de fuente general */
  .terminal-content {
    padding: 20px;
    color: #00ff00;
    line-height: 1.5;
    font-size: 1rem;
    flex: 1;
    overflow-y: auto; /* Scroll en todo el contenido */
    display: flex;
    flex-direction: column;
  }

  .terminal-line {
    margin-bottom: 10px;
    font-size: 1.1rem; /* Aumentado de 0.9rem */
  }

  /* Contenedor principal reorganizado */
  .whoami-output {
    background: #2d2d2d;
    padding: 20px;
    border-radius: 8px;
    margin: 15px 0;
    border-left: 4px solid #00ff00;
    border: 1px solid #444;
    /* ELIMINADO: overflow-y: auto */
    /* ELIMINADO: flex: 1 */
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* NUEVO: se expande según contenido */
    flex-shrink: 0; /* No se encoje */
  }

  /* Información del usuario con fuente más grande */
  .user-info h3 {
    color: #fff;
    margin: 0 0 10px 0;
    font-size: 1.4rem; /* Aumentado de 1.1rem */
    font-weight: 600;
  }

  .role, .location {
    color: #b0b0b0;
    margin: 6px 0; /* Un poco más de margen */
    font-size: 1rem; /* Aumentado de 0.8rem */
    line-height: 1.5;
  }

  .role {
    font-style: italic;
    border-left: 3px solid #729fcf; /* Un poco más gruesa */
    padding-left: 12px;
    margin-left: 3px;
  }

  /* Nuevo layout: dos columnas para user-info y social-links */
  .content-main {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Dos columnas iguales */
    gap: 25px; /* Espacio entre columnas */
  }

  /* Ajustar user-info para ocupar la columna izquierda */
  .user-info {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Social section en columna derecha */
  .social-section {
    padding-top: 0; /* Ya no necesita padding-top */
    border-top: none; /* Sin borde superior */
  }

  .social-section h4 {
    color: #729fcf;
    margin-bottom: 15px; /* Más espacio debajo */
    font-size: 1.1rem; /* Aumentado de 0.9rem */
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  /* Social links más grandes */
  .social-link {
    color: var(--link-color, #00ff00);
    text-decoration: none;
    padding: 10px 15px; /* Más padding */
    background: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 12px; /* Más espacio entre icono y texto */
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 1rem; /* Aumentado de 0.85rem */
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(5px); /* Efecto más pronunciado */
  }

  .social-link i {
    width: 20px; /* Iconos más grandes */
    text-align: center;
    font-size: 1.2rem; /* Aumentado de 0.9rem */
  }

  /* Skills section reorganizada como cards en grid */
  .skills-section {
    padding-top: 20px;
    border-top: 1px solid #444;
  }

  .skills-section h4 {
    color: #729fcf;
    margin-bottom: 15px;
    font-size: 1.1rem; /* Aumentado de 0.9rem */
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  /* Grid de habilidades */
  .skill-categories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); /* Cards responsivas */
    gap: 15px; /* Espacio entre cards */
  }

  /* Cada categoría como card */
  .skill-category {
    background: rgba(255, 255, 255, 0.05);
    padding: 15px; /* Más padding */
    border-radius: 8px; /* Bordes más redondeados */
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .skill-category:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(114, 159, 207, 0.3);
    transform: translateY(-2px); /* Efecto hover sutil */
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .skill-category strong {
    color: #ffa500;
    margin-bottom: 8px; /* Espacio entre título y habilidades */
    font-weight: 600;
    font-size: 1.05rem; /* Aumentado de 0.85rem */
    display: block; /* Hacer que sea bloque para separación */
  }

  .skill-category span {
    color: #ccc;
    font-size: 0.95rem; /* Aumentado de 0.8rem */
    line-height: 1.4;
    display: block; /* Asegurar que cada línea se muestre correctamente */
  }

  /* Responsive: en pantallas pequeñas, una columna */
  @media (max-width: 768px) {
    .content-main {
      grid-template-columns: 1fr; /* Una columna en móviles */
      gap: 20px;
    }
    
    .skill-categories {
      grid-template-columns: 1fr; /* Una columna en móviles */
    }
  }

  /* Ajustar scrollbar para coincidir con FileExplorer */
  .terminal-content::-webkit-scrollbar,
  .whoami-output::-webkit-scrollbar {
    width: 10px; /* Un poco más ancho */
  }

  .terminal-content::-webkit-scrollbar-track,
  .whoami-output::-webkit-scrollbar-track {
    background: #1a1a1a;
    border-radius: 5px; /* Más redondeado */
  }

  .terminal-content::-webkit-scrollbar-thumb,
  .whoami-output::-webkit-scrollbar-thumb {
    background: #444;
    border-radius: 5px; /* Más redondeado */
    border: 2px solid #1a1a1a; /* Borde más delgado */
  }

  .terminal-content::-webkit-scrollbar-thumb:hover,
  .whoami-output::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .terminal-window {
      /* RESET TOTAL */
      position: relative !important;
      width: 95vw !important;           /* ANCHO: 95% del viewport */
      max-width: 95vw !important;       /* MÁXIMO: 95% del viewport */
      height: auto !important;          /* ALTURA: automática según contenido */
      min-height: auto !important;
      
      /* POSICIONAMIENTO */
      top: 20px !important;             /* DEJA ESPACIO PARA LA TOP-BAR */
      left: 2.5vw !important;           /* CENTRADO HORIZONTAL */
      right: auto !important;
      bottom: auto !important;
      margin: 0 !important;
      
      /* EVITAR DESBORDAMIENTO */
      overflow: hidden !important;
      box-sizing: border-box !important;
      
      /* SIN SOMBRAS QUE AUMENTEN EL TAMAÑO */
      box-shadow: 0 5px 15px rgba(0,0,0,0.3) !important;
    }
    
    .terminal-content {
      /* CONTENIDO AJUSTADO */
      padding: 15px !important;
      font-size: 0.9rem !important;
      max-height: none !important;
      overflow: visible !important;
      
      /* ASEGURAR QUE EL CONTENIDO NO SE SALGA */
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
    }
    
    /* FORZAR UNA COLUMNA */
    .content-main {
      grid-template-columns: 1fr !important;
      gap: 15px !important;
    }
    
    /* AJUSTAR TEXTO LARGO */
    .terminal-line {
      white-space: normal !important;
      word-break: break-word !important;
    }
    
    /* LIMITAR ANCHO DE ELEMENTOS INTERNOS */
    .social-link, .skill-category {
      max-width: 100% !important;
    }
  }

  /* PARA PANTALLAS MUY PEQUEÑAS (ANDROID) */
  /* PARA PANTALLAS MUY PEQUEÑAS (ANDROID) */
@media (max-width: 480px) {
  .terminal-window {
    /* ANCHO Y POSICIÓN CON MÁRGENES */
    width: 100vw !important;           /* 10% de margen horizontal (5% cada lado) */
    max-width: 95.5vw !important;    
    /* MÁRGENES VERTICALES */
    
    margin-bottom: 25px !important;   /* MARGEN INFERIOR PARA FILE-EXPLORER */
    
    /* ALTURA CONTROLADA */
    height: auto !important;          /* ALTURA AUTOMÁTICA */
    min-height: auto !important;
    max-height: 46vh !important;      /* MÁXIMO 50% de la pantalla */

    bottom: 50px !important;
    left: 10px !important;
    right: 10px !important;
    top: 15px !important;
    
    /* SCROLL INTERNO SI ES NECESARIO */
    overflow-y: auto !important;
  }
  
  /* CONTENIDO CON PADDING INTERNO */
  .terminal-content {
    padding: 15px !important;         /* PADDING INTERNO */
    font-size: 0.85rem !important;
    
    /* MÁRGENES INTERNOS ADICIONALES */
    margin: 0 !important;
  }
  
  /* BARRA DE TÍTULO COMPACTA */
  .terminal-titlebar {
    padding: 8px 10px !important;     /* PADDING COMPACTO */
    margin: 0 !important;
  }
  
  /* CONTENEDOR DE INFORMACIÓN CON ESPACIADO */
  .whoami-output {
    padding: 12px !important;
    margin: 8px 0 12px 0 !important;  /* MARGEN VERTICAL */
  }
  
  /* AJUSTAR ELEMENTOS INTERNOS PARA MÓVIL */
  .content-main {
    gap: 12px !important;
  }
  
  .social-link {
    padding: 8px 10px !important;     /* BOTONES MÁS COMPACTOS */
    margin: 2px 0 !important;
  }
  
  .skill-category {
    padding: 10px !important;
    margin: 3px 0 !important;
  }
}

</style>