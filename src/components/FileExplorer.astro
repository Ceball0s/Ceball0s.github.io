  .file-description {
    color: #b0b0b0;
    font-size: 1rem; /* Más grande */
    line-height: 1.6;
    font-family: 'Ubuntu', sans-serif;
    margin: 0;
  }

  .technologies-section, .achievements-section {
    margin-top: 10px;
  }

  .technologies-section h4, .achievements-section h4 {
    color: #729fcf;
    margin: 0 0 12px 0;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }

  .technologies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 15px;
  }

  .tech-tag {
    background: rgba(114, 159, 207, 0.2);
    color: #94c1ff;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.9rem;
    font-family: 'Ubuntu Mono', monospace;
    border: 1px solid rgba(114, 159, 207, 0.3);
    transition: all 0.2s;
  }

  .tech-tag:hover {
    background: rgba(114, 159, 207, 0.3);
    transform: translateY(-1px);
  }

  .achievements-list {
    color: #ccc;
    font-size: 0.95rem;
    line-height: 1.5;
    padding-left: 25px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .achievements-list li {
    position: relative;
  }

  .achievements-list li:before {
    content: "•";
    color: #729fcf;
    font-weight: bold;
    position: absolute;
    left: -15px;
  }

  .more-items {
    color: #888;
    font-style: italic;
  }

  .file-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto; 
    padding-top: 20px;
    border-top: 1px solid #444;
    
  }

  .github-btn {
    background: #333;
    border: 1px solid #555;
    color: #fff;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: all 0.2s;
    font-size: 1rem;
    font-weight: 500;
  }

  .github-btn:hover {
    background: #24292e;
    border-color: #181717;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
  }

  .file-stats {
    display: flex;
    gap: 20px;
    color: #888;
    font-size: 0.9rem;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .explorer-statusbar {
    background: #353535;
    padding: 12px 25px;
    border-top: 1px solid #404040;
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: #b0b0b0;
    font-family: 'Ubuntu Mono', monospace;
    flex-shrink: 0;
  }

  .status-left, .status-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .selected-count, .total-size, .view-mode, .sort-order {
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }

  /* Scrollbar personalizado */
  .explorer-content::-webkit-scrollbar {
    width: 12px;
  }

  .explorer-content::-webkit-scrollbar-track {
    background: #2d2d2d;
    border-radius: 8px;
  }

  .explorer-content::-webkit-scrollbar-thumb {
    background: #555;
    border-radius: 8px;
    border: 3px solid #2d2d2d;
  }

  .explorer-content::-webkit-scrollbar-thumb:hover {
    background: #666;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .file-explorer {
      width: 800px;
      height: 700px;
      right: 20px;
      bottom: 20px;
    }
  }

  @media (max-width: 1024px) {
    .file-explorer {
      width: 700px;
      height: 650px;
    }
    
    .file-item {
      flex-direction: column;
      gap: 20px;
    }
    
    .file-icon {
      align-self: flex-start;
    }
  }

  @media (max-width: 768px) {
    .file-explorer {
      /* Cambios principales para Android/móviles */
      position: fixed !important;
      width: calc(100vw - 20px) !important;
      height: 45vh !important; /* Ocupa el 45% del viewport */
      max-height: 45vh !important;
      min-height: auto !important;
      
      /* Posicionamiento en la parte inferior */
      bottom: 10px !important;
      left: 10px !important;
      right: 10px !important;
      top: auto !important;
      
      margin: 0 auto;
      border-radius: 12px;
      z-index: 1000;
    }
    
    .explorer-content {
      /* Asegurar que el contenido sea scrollable */
      flex: 1;
      overflow-y: auto;
      padding: 16px;
      gap: 16px;
      min-height: 0; /* Importante para flex */
    }
    .explorer-titlebar {
      padding: 10px;
      gap: 10px;
    }

    .explorer-path {
      flex: 0 1 auto; /* Se estira menos, solo lo necesario */
      padding: 5px 10px;
      font-size: 0.85rem;
    }
    .explorer-toolbar{
      display: none;
    }
    .file-header {
      display: flex;
      flex-direction: column; 
      align-items: stretch; 
      gap: 10px; 
      
      margin-bottom: 5px;
    }
    .file-title {
      font-size: 1.2rem;
      max-width: 85%; /* Ocupa menos horizontalmente */
      line-height: 1.2;
    }
    .explorer-statusbar {
      padding: 10px;
      flex-wrap: wrap; /* Permite que los elementos bajen si no caben */
      justify-content: center;
      gap: 8px;
      height: auto;
    }
    .status-left, .status-right {
      gap: 5px;
      justify-content: space-between;
      width: 100%; /* Forzamos a que se organicen en bloques */
    }

    .selected-count, .total-size, .sort-order, .view-mode {
      font-size: 0.75rem; /* Texto más pequeño para que quepa todo */
      padding: 2px 6px;
      white-space: nowrap; /* Evita que el texto se rompa en dos líneas */
    }
    .technologies-section, .achievements-section {
      margin-top: 5px; /* Menos espacio arriba de las secciones */
    }

    .file-actions {
      padding-top: 12px; /* Reducido de 20px */
      margin-top: 15px;
      gap: 10px;
    }

    .github-btn {
      padding: 8px 12px; /* Mucho más compacto */
      font-size: 0.9rem;
    }

    .github-btn span {
      display: none; /* Oculta "Ver en GitHub" completo */
    }
    
    .github-btn::after {
      content: "GitHub"; /* Solo muestra la palabra clave */
    }

    .file-stats {
      flex-direction: column; /* Apila los stats para que no empujen el botón */
      gap: 4px;
      font-size: 0.8rem;
    }

    .stat-item {
      white-space: nowrap;
    }

  }


  @media (max-width: 480px) {
    .file-explorer {
      width: 100%;
      height: auto;
      min-height: auto;
    }

    .explorer-content {
      padding: 16px;
      gap: 16px;
    }
  }
</style>