---
// pages/desktop.astro
import TerminalWindow from '../components/TerminalWindow.astro';
import FileExplorer from '../components/FileExplorer.astro';
---

<html lang="es" class="dark-theme">
<head>
  <link rel="icon" type="image/x-icon" href="favicon.svg">
  <link rel="manifest" href="/site.webmanifest" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Escritorio - Portfolio Ubuntu</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:wght@400;700&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ubuntu-orange: #E95420;
      --ubuntu-purple: #77216F;
      --ubuntu-dark: #2C001E;
      --ubuntu-light: #F6F6F5;
    }
    
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
    }
    
    .dark-theme {
      background: linear-gradient(135deg, var(--ubuntu-dark) 0%, #1a1a1a 100%);
      color: #fff;
    }
  </style>
</head>
<script>
  // Función para actualizar el reloj
  function updateClock() {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    
    const clockElement = document.querySelector('.time');
    if (clockElement) {
      clockElement.textContent = `${hours}:${minutes}`;
    }
  }

  // Actualizar el reloj inmediatamente y cada minuto
  document.addEventListener('DOMContentLoaded', function() {
    updateClock(); // Primera actualización
    setInterval(updateClock, 60000); // Actualizar cada minuto
  });

  window.showNotification = function ({ 
    title, 
    message, 
    icon = "fa-info-circle", 
    color = "#E95420",
    duration = 3000 
  }) {
    const container = document.getElementById("notifications");
    if (!container) return;

    const notif = document.createElement("div");
    notif.className = "notification";
    notif.style.setProperty("--accent", color);

    notif.innerHTML = `
      <i class="fas ${icon}"></i>
      <div class="content">
        <div class="title">${title}</div>
        <div class="message">${message}</div>
      </div>
    `;

    container.appendChild(notif);

    setTimeout(() => {
      notif.style.opacity = "0";
      notif.style.transform = "translateX(20px)";
      setTimeout(() => notif.remove(), 300);
    }, duration);
  };

  if (Notification.permission === 'granted') {
    new Notification('Title', { body: 'Hello' });
  } else {
    Notification.requestPermission().then(p => {
      if (p === 'granted') new Notification('Title', { body: 'Hello' });
    });
  }

  navigator.serviceWorker.getRegistration().then(reg => {
    reg?.showNotification('Title', { body: 'Hello' });
  });
</script>

<body>
  <!-- Escritorio Ubuntu -->
  <div class="ubuntu-desktop">
    
    <!-- Barra superior Ubuntu -->
    <div class="top-bar">
      <div class="left-menu">
        <span class="ubuntu-logo" style="font-size: 1.2rem;"></span>
        <span class="menu-item">Aplicaciones</span>
        <span class="menu-item">Lugares</span>
        <span class="menu-item">Sistema</span>
      </div>
      <div class="system-tray">
        <span class="tray-item"><i class="fas fa-wifi"></i></span>
        <span class="tray-item"><i class="fas fa-volume-up"></i></span>
        <span class="tray-item"><i class="fas fa-battery-half"></i></span>
        <span class="time">14:30</span>
        <span class="user-menu">
          <i class="fas fa-user-circle"></i>
          <span>miguel</span>
        </span>
      </div>
    </div>

    <!-- Iconos del escritorio -->
    <div class="desktop-icons">
      <div class="desktop-icon">
        <i class="fas fa-home"></i>
        <span>Home</span>
      </div>
      <div class="desktop-icon">
        <i class="fas fa-folder"></i>
        <span>Documentos</span>
      </div>
      <div class="desktop-icon">
        <i class="fas fa-trash"></i>
        <span>Papelera</span>
      </div>
      
    </div>

    <!-- Ventanas -->
    <TerminalWindow />
    <FileExplorer />

  </div>

  <style>
    .ubuntu-desktop {
      height: 100vh;
      width: 100vw;
      position: relative;
      overflow: hidden;
      font-family: 'Ubuntu', sans-serif;
      background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/images/wallpaper.png');
      background-size: cover;

    }

    .top-bar {
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      color: white;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.9rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }


    .ubuntu-logo {
      color: var(--ubuntu-orange);
    }

    .menu-item {
      cursor: pointer;
      padding: 5px 10px;
      border-radius: 4px;
      transition: background 0.2s;
    }

    .menu-item:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .system-tray {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .tray-item {
      cursor: pointer;
      padding: 5px;
    }

    .time {
      padding: 5px 10px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
    }

    .user-menu {
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      padding: 5px 10px;
      border-radius: 4px;
      transition: background 0.2s;
    }

    .user-menu:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .desktop-icons {
      position: absolute;
      top: 80px;
      left: 40px;
      display: flex;
      flex-direction: column;
      gap: 25px;
      z-index: 1;
    }

    .desktop-icon {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 80px;
      cursor: pointer;
      padding: 10px;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .desktop-icon:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .desktop-icon i {
      font-size: 2rem;
      color: var(--ubuntu-orange);
      margin-bottom: 8px;
    }

    .desktop-icon span {
      color: #fff;
      font-size: 0.85rem;
      text-align: center;
    }

    .launcher {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      padding: 15px 8px;
      display: flex;
      flex-direction: column;
      gap: 15px;
      z-index: 100;
    }

    .launcher-item {
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      cursor: pointer;
      color: #fff;
      font-size: 1.2rem;
      transition: all 0.2s;
    }

    .launcher-item:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .launcher-item.active {
      background: rgba(233, 84, 32, 0.3);
      color: var(--ubuntu-orange);
    }

    /* Responsive */
    @media (max-width: 768px) {

      .top-bar {
        padding: 6px 10px;
        font-size: 0.8rem;
        justify-content: flex-end; 

      }

      .left-menu {
        display: none; /* GNOME también lo hace */
      }

      .ubuntu-desktop {
        /* CONFIGURACIÓN BÁSICA */
        display: block !important;        /* NO FLEX, SINO BLOQUE NORMAL */
        min-height: 100vh !important;
        overflow-y: auto !important;
        padding: 0 !important;
        margin: 0 !important;
        
        /* FONDO VISIBLE */
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), 
                    url('/images/wallpaper.png') !important;
        background-size: cover !important;
        background-attachment: fixed !important;
        
      }

      /* Terminal como elemento normal en el flujo */
       /* TERMINAL - PRIMERO */
      .terminal-window {
        margin: 40px auto 10px auto !important;  /* MARGEN PARA TOP-BAR Y FILE EXPLORER */
        display: block !important;
      }
      
      .file-explorer {
        position: fixed !important;
        width: calc(100vw - 20px) !important;
        height: 45vh !important;
        max-height: 45vh !important;
        bottom: 10px !important;
        left: 10px !important;
        right: 10px !important;
        top: auto !important;
        margin: 0 auto !important;
        z-index: 1000;
      }
    }
    /* GNOME-like notifications */
    #notifications {
      position: fixed;
      top: 60px;
      right: 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      z-index: 9999;
      pointer-events: none;
    }

    .notification {
      background: rgba(20, 20, 20, 0.98);
      color: #fff;
      min-width: 280px;
      max-width: 340px;
      padding: 14px 16px;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      display: flex;
      gap: 12px;
      align-items: flex-start;
      animation: slideIn 0.25s ease-out;
      border-left: 4px solid var(--accent, #E95420);
    }

    .notification i {
      font-size: 1.3rem;
      color: var(--accent, #E95420);
      margin-top: 2px;
    }

    .notification .content {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .notification .title {
      font-weight: 600;
      font-size: 0.95rem;
    }

    .notification .message {
      font-size: 0.85rem;
      color: #ccc;
    }
    @keyframes slideIn {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }
  </style>
  <div id="notifications"></div>
</body>
</html>