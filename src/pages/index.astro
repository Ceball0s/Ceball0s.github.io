---
import Grub from '../components/boot/Grub.astro';
import Kernel from '../components/boot/Kernel.astro';
import BootLogs from '../components/boot/BootLogs.astro';
---
<head>
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
</head>

<div id="screen">
  <div data-view="grub"><Grub /></div>
  <div data-view="kernel"><Kernel /></div>
  <div data-view="logs"><BootLogs /></div>
</div>

<script type="module" src="/src/core/boot.ts"></script>

<style is:global>
  :root {
    --bg-grub: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/images/background-tela.jpg');
    --bg-logs: #000000;
    --bg-terminal: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/images/wallpaper.png');
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: black;
    overflow: hidden;
  }

  #screen {
    position: relative;
    width: 100vw;
    height: 100vh;
    background-color: var(--screen-bg, var(--bg-grub));
    transition: background 300ms ease;
    /* Fuente por defecto para todo el sistema */
    font-family: 'Ubuntu Mono', 'JetBrains Mono', monospace;
  }

  [data-view] {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>